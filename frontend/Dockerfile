FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci --no-audit --no-fund
COPY . .
ARG VITE_PORTFOLIO_NAME=[YOUR_NAME]
ARG VITE_PORTFOLIO_ROLE=[YOUR_ROLE]
ARG VITE_PORTFOLIO_MAJOR=[YOUR_MAJOR]
ARG VITE_PORTFOLIO_EMAIL=
ARG VITE_PORTFOLIO_GITHUB=
ARG VITE_PORTFOLIO_LINKEDIN=
ARG VITE_PORTFOLIO_INSTAGRAM=
ARG VITE_PORTFOLIO_FACEBOOK=
ARG VITE_PORTFOLIO_LOCATION=
ARG VITE_PORTFOLIO_AVAILABILITY=
ARG VITE_POLL_INTERVAL_MS=30000
ENV VITE_PORTFOLIO_NAME=$VITE_PORTFOLIO_NAME \
    VITE_PORTFOLIO_ROLE=$VITE_PORTFOLIO_ROLE \
    VITE_PORTFOLIO_MAJOR=$VITE_PORTFOLIO_MAJOR \
    VITE_PORTFOLIO_EMAIL=$VITE_PORTFOLIO_EMAIL \
    VITE_PORTFOLIO_GITHUB=$VITE_PORTFOLIO_GITHUB \
    VITE_PORTFOLIO_LINKEDIN=$VITE_PORTFOLIO_LINKEDIN \
    VITE_PORTFOLIO_INSTAGRAM=$VITE_PORTFOLIO_INSTAGRAM \
    VITE_PORTFOLIO_FACEBOOK=$VITE_PORTFOLIO_FACEBOOK \
    VITE_PORTFOLIO_LOCATION=$VITE_PORTFOLIO_LOCATION \
    VITE_PORTFOLIO_AVAILABILITY=$VITE_PORTFOLIO_AVAILABILITY \
    VITE_POLL_INTERVAL_MS=$VITE_POLL_INTERVAL_MS
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:8080/health || exit 1
