FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci --no-audit --no-fund
COPY . .
ARG VITE_PORTFOLIO_NAME=Võ Văn Chung
ARG VITE_PORTFOLIO_ROLE=Sinh viên
ARG VITE_PORTFOLIO_MAJOR=Kỹ thuật phần mềm
ARG VITE_PORTFOLIO_EMAIL=vovanchung357@gmail.com
ARG VITE_PORTFOLIO_GITHUB=https://github.com/VoVanChung2508
ARG VITE_PORTFOLIO_LINKEDIN=https://www.linkedin.com/in/vovan-chung-05a44b255/
ARG VITE_PORTFOLIO_INSTAGRAM=https://www.instagram.com/chungvv103
ARG VITE_PORTFOLIO_FACEBOOK=https://www.facebook.com/vo.van.chung.276466/
ARG VITE_PORTFOLIO_LOCATION=Đà Nẵng, Việt Nam
ARG VITE_PORTFOLIO_AVAILABILITY=Sẵn sàng nhận dự án mới
ARG VITE_POLL_INTERVAL_MS=30000
ENV VITE_PORTFOLIO_NAME=$VITE_PORTFOLIO_NAME \
    VITE_PORTFOLIO_ROLE=$VITE_PORTFOLIO_ROLE \
    VITE_PORTFOLIO_MAJOR=$VITE_PORTFOLIO_MAJOR \
    VITE_PORTFOLIO_EMAIL=$VITE_PORTFOLIO_EMAIL \
    VITE_PORTFOLIO_GITHUB=$VITE_PORTFOLIO_GITHUB \
    VITE_PORTFOLIO_LINKEDIN=$VITE_PORTFOLIO_LINKEDIN \
    VITE_PORTFOLIO_INSTAGRAM=$VITE_PORTFOLIO_INSTAGRAM \
    VITE_PORTFOLIO_FACEBOOK=$VITE_PORTFOLIO_FACEBOOK \
    VITE_PORTFOLIO_LOCATION=$VITE_PORTFOLIO_LOCATION \
    VITE_PORTFOLIO_AVAILABILITY=$VITE_PORTFOLIO_AVAILABILITY \
    VITE_POLL_INTERVAL_MS=$VITE_POLL_INTERVAL_MS
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:8080/health || exit 1
